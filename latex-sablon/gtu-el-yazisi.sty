% Özet: yapışkan not kâğıdı + selobant
\def\gtu@yapiskan#1{%
  \fill[black!18,opacity=0.5] ([shift={(0.8mm,-0.8mm)}]frame.south west) rectangle ([shift={(0.8mm,-0.8mm)}]frame.north east);
  \fill[notsarisi] (frame.south west) rectangle (frame.north east);
  \draw[gtu el,line width=0.4pt,olive!70!black,opacity=0.6] (frame.north west) to (frame.south west);
  \draw[gtu el,line width=0.4pt,olive!70!black,opacity=0.6] (frame.north east) to (frame.south east);
  \if#1u\draw[gtu el,line width=0.4pt,olive!70!black,opacity=0.6] (frame.south west) to (frame.south east);\fi
  \if#1l\draw[gtu el,line width=0.4pt,olive!70!black,opacity=0.6] (frame.south west) to (frame.south east);\fi
  \if#1u\gtu@bant{[yshift=-0.8mm]frame.north}{-3}\fi
  \if#1f\gtu@bant{[yshift=-0.8mm]frame.north}{-3}\fi}
