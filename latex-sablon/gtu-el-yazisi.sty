\def\gtu@koseli#1{%
  \coordinate (gtuU) at ([xshift=1.2mm,yshift=-0.5mm]frame.north west);
  \coordinate (gtuA) at ([xshift=1.2mm,yshift=0.5mm]frame.south west);
  \draw[gtu kalem,cozumrengi,line width=0.9pt] (gtuU) to (gtuA);
  \if#1u\draw[gtu kalem,cozumrengi,line width=0.9pt,gtu tasma=0.3mm] (gtuU) to ++(2.5mm,0);
        \draw[gtu kalem,cozumrengi,line width=0.9pt,gtu tasma=0.3mm] (gtuA) to ++(2.5mm,0);\fi
  \if#1f\draw[gtu kalem,cozumrengi,line width=0.9pt,gtu tasma=0.3mm] (gtuU) to ++(2.5mm,0);\fi
  \if#1l\draw[gtu kalem,cozumrengi,line width=0.9pt,gtu tasma=0.3mm] (gtuA) to ++(2.5mm,0);\fi}
