%% 9. Kağıt arka planı: kareli / çizgili / noktalı / düz + kırmızı kenar
%% ---------------------------------------------------------------------
\newcommand\gtu@kagit@kareli{%
  \draw[karerengi,line width=0.25pt,step=5mm,shift={(0,\paperheight)}]
    (0,-\paperheight) grid (\paperwidth,0);}
\newcommand\gtu@kagit@cizgili{%
  \draw[karerengi,line width=0.35pt,ystep=5mm,xstep=\paperwidth,
    shift={(0,\paperheight)}] (0,-\paperheight) grid (\paperwidth,-25mm);}
\newcommand\gtu@kagit@noktali{%
  \draw[noktarengi,line width=0.9pt,dash pattern=on 0pt off 5mm,
    line cap=round,xstep=5mm,ystep=\paperheight,shift={(0,\paperheight)}]
    (0,-\paperheight) grid (\paperwidth,0);}
\newcommand\gtu@kagit@duz{}
\newcommand\gtu@arkaplan{%
  \put(0,0){\begin{tikzpicture}[inner sep=0pt]
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fill[kagitrengi] (0,0) rectangle (\paperwidth,\paperheight);
    \gtu@kagitciz
    \draw[kenarrengi,line width=0.6pt] (20mm,0) -- (20mm,\paperheight);
  \end{tikzpicture}}}
\AddToShipoutPictureBG{\gtu@arkaplan}

%% ---------------------------------------------------------------------
%% 10. Başlıklar / headings
%% ---------------------------------------------------------------------
\newsavebox\gtu@kutu
% altı elle çizilmiş başlık
\newcommand\gtu@altcizgili[2]{% #1 renk, #2 metin
  \sbox\gtu@kutu{#2}%
  \ifdim\wd\gtu@kutu>\dimexpr\linewidth-3em\relax
    \parbox[t]{\dimexpr\linewidth-3em}{\RaggedRight#2\par\vspace{-0.9ex}%
      \tikz\draw[gtu kalem,#1,line width=1pt] (0,0) to (\linewidth,0.5pt);}%
  \else
    \tikz[baseline=(t.base)]{\node[inner sep=0pt](t){\usebox\gtu@kutu};
      \draw[gtu kalem,#1,line width=1pt] ([yshift=-1.4mm]t.south west)
        to ([yshift=-1.1mm,xshift=3mm]t.south east);
      \draw[gtu ikinci,#1] ([yshift=-1.9mm,xshift=1mm]t.south west)
        to ([yshift=-1.6mm,xshift=2mm]t.south east);}%
  \fi}
\titleformat{\section}[hang]
  {\gtubaslikfont\LARGE\color{kirmizikalem}}
  {\thesection}{0.5em}{\gtu@altcizgili{kirmizikalem}{#1}}
\titleformat{\subsection}[hang]
  {\gtubaslikfont\Large\color{murekkep}}
  {\thesubsection}{0.5em}{\gtu@vurgukutu{gtufosfor-yesil}{#1}}
\titleformat{\subsubsection}[hang]
  {\gtubaslikfont\large\color{morkalem}}
  {\thesubsubsection}{0.5em}{{\normalfont→}\ #1}
\titleformat{\paragraph}[runin]
  {\gtubaslikfont\color{kirmizikalem}}{\theparagraph}{0.5em}{#1}
\titlespacing*{\section}{0pt}{5mm plus 1mm}{3mm}
\titlespacing*{\subsection}{0pt}{4mm plus 1mm}{2mm}
\titlespacing*{\subsubsection}{0pt}{3mm plus 1mm}{1.5mm}
\titlespacing*{\paragraph}{0pt}{2mm}{0.6em}
\ifgtu@numarali\setcounter{secnumdepth}{3}\else\setcounter{secnumdepth}{0}\fi

%% ---------------------------------------------------------------------
%% 11. \vurgu{...}  fosforlu kalem (satır sonlarında bölünebilir)
%% ---------------------------------------------------------------------
\ExplSyntaxOn
\seq_new:N \l__gtu_vurgu_seq
\seq_new:N \l__gtu_vurgu_out_seq
\tl_new:N \l__gtu_vurgu_acc_tl
\int_new:N \l__gtu_vurgu_cnt_int
\int_new:N \l__gtu_vurgu_tmp_int
\box_new:N \l__gtu_vurgu_box
\cs_new_protected:Npn \__gtu_vurgu_say:n #1
  {
    \regex_count:nnN { \cM\$ } {#1} \l__gtu_vurgu_tmp_int
    \int_add:Nn \l__gtu_vurgu_cnt_int { \l__gtu_vurgu_tmp_int }
    \regex_count:nnN { \c{\(} | \c{\)} } {#1} \l__gtu_vurgu_tmp_int
    \int_add:Nn \l__gtu_vurgu_cnt_int { \l__gtu_vurgu_tmp_int }
  }
\cs_new_protected:Npn \__gtu_vurgu_kelime:nn #1#2
  {
    \hbox_set:Nn \l__gtu_vurgu_box {#2}
    \mode_leave_vertical:
    \rlap { \color {#1} \rule [ -0.24em ] { \box_wd:N \l__gtu_vurgu_box } { 1.04em } }
    \box_use_drop:N \l__gtu_vurgu_box
  }
\cs_new_protected:Npn \__gtu_vurgu_bosluk:n #1
  {
    \group_begin:
    \color {#1}
    \tex_leaders:D \tex_hrule:D height 0.8em depth 0.24em
      \tex_hskip:D \tex_fontdimen:D 2 \tex_font:D
        plus \tex_fontdimen:D 3 \tex_font:D minus \tex_fontdimen:D 4 \tex_font:D
    \group_end:
  }
\cs_new_protected:Npn \gtu_vurgu:nn #1#2
  {
    \seq_set_split:Nnn \l__gtu_vurgu_seq { ~ } {#2}
    \seq_remove_all:Nn \l__gtu_vurgu_seq { }
    \seq_clear:N \l__gtu_vurgu_out_seq
    \tl_clear:N \l__gtu_vurgu_acc_tl
    \int_zero:N \l__gtu_vurgu_cnt_int
    \seq_map_inline:Nn \l__gtu_vurgu_seq
      {
        \tl_if_empty:NTF \l__gtu_vurgu_acc_tl
          { \tl_set:Nn \l__gtu_vurgu_acc_tl {##1} }
          { \tl_put_right:Nn \l__gtu_vurgu_acc_tl { ~ ##1 } }
        \__gtu_vurgu_say:n {##1}
        \int_if_even:nT { \l__gtu_vurgu_cnt_int }
          {
            \seq_put_right:NV \l__gtu_vurgu_out_seq \l__gtu_vurgu_acc_tl
            \tl_clear:N \l__gtu_vurgu_acc_tl
            \int_zero:N \l__gtu_vurgu_cnt_int
          }
      }
    \tl_if_empty:NF \l__gtu_vurgu_acc_tl
      { \seq_put_right:NV \l__gtu_vurgu_out_seq \l__gtu_vurgu_acc_tl }
    \mode_leave_vertical:
    \seq_map_indexed_inline:Nn \l__gtu_vurgu_out_seq
      {
        \int_compare:nNnT {##1} > { 1 } { \__gtu_vurgu_bosluk:n {#1} }
        \__gtu_vurgu_kelime:nn {#1} {##2}
      }
  }
\NewDocumentCommand \vurgu { O{sari} +m }
  { \gtu_vurgu:nn { gtufosfor-#1 } {#2} }
% tek parça (bölünmeyen) fosfor kutusu -- başlıklar için
\cs_new_protected:Npn \gtu@vurgukutu #1#2
  { \__gtu_vurgu_kelime:nn {#1} {#2} }
