      {\small\color{kursunkalem}\gtu@lbl@orijinal: \gtu@dosyayazi{#4}%
        \IfValueT{#1}{\quad·\quad#1}\par}};
    \gtu@dortgen{murekkep}{gtuNB.south west}{gtuNB.north east}
