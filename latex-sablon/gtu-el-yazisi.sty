%% ---------------------------------------------------------------------
%% 8. Elle çizilmiş çizgiler (TikZ): her kenar ayrı, hafif eğri ve
%%    köşelerde biraz taşan bir kalem darbesi olarak çizilir.
%% ---------------------------------------------------------------------
\def\gtu@tasma{0.9mm}   % köşelerde taşma
\def\gtu@egri{0.9pt}    % eğrilik
\tikzset{
  gtu tasma/.code={\def\gtu@tasma{#1}},
  gtu egri/.code={\def\gtu@egri{#1}},
  gtu el/.style={line cap=round, line join=round,
    to path={\pgfextra{%
        \pgfmathsetlengthmacro\gtu@ra{\gtu@egri*rand}%
        \pgfmathsetlengthmacro\gtu@rb{\gtu@egri*rand}%
        \pgfmathsetlengthmacro\gtu@rc{\gtu@tasma*(0.25+0.75*rnd)}%
        \pgfmathsetlengthmacro\gtu@rd{\gtu@tasma*(0.25+0.75*rnd)}}%
      ($(\tikztostart)!-\gtu@rc!(\tikztotarget)$)
      .. controls ($(\tikztostart)!0.3!(\tikztotarget)+(\gtu@ra,\gtu@rb)$)
              and ($(\tikztostart)!0.7!(\tikztotarget)+(\gtu@rb,-\gtu@ra)$) ..
      ($(\tikztotarget)!-\gtu@rd!(\tikztostart)$) \tikztonodes}},
  gtu kalem/.style={gtu el, line width=0.75pt},
  gtu ikinci/.style={gtu el, line width=0.35pt, opacity=0.55},
  gtu bant/.style={fill=gray!40, fill opacity=0.4, draw=gray!50,
    draw opacity=0.35, line width=0.2pt, minimum width=13mm,
    minimum height=3.8mm, inner sep=0pt},
}
% \gtu@dortgen{renk}{GB köşe}{KD köşe} : iki geçişli eskiz dikdörtgen
\newcommand\gtu@dortgen[3]{%
  \draw[gtu kalem,#1] (#2) to (#2-|#3) (#2-|#3) to (#3) (#3) to (#3-|#2) (#3-|#2) to (#2);
  \draw[gtu ikinci,#1] (#2) to (#2-|#3) (#2-|#3) to (#3) (#3) to (#3-|#2) (#3-|#2) to (#2);}
% bant parçası (selobant)
\newcommand\gtu@bant[2]{\node[gtu bant, rotate=#2] at (#1) {};}

% tcolorbox kutuları: dolgu "underlay"de (metnin altında), elle çizilmiş
% çerçeve ve etiket "overlay"de (en üstte) çizilir. Etiket üst çizgideki
% bir boşluğa yazılır -- öğrencinin kutuya başlık yazması gibi.
\def\gtu@dolgu#1{\ifx\relax#1\relax\else
  \fill[#1] (frame.south west) rectangle (frame.north east);\fi}
% \gtu@cerceve{renk}{parça u/f/m/l}{çift 0/1}
\def\gtu@cerceve#1#2#3{%
  \def\gtu@etiketvar{0}%
  \ifx\gtu@kutuetiketi\@empty\else
    \if#2u\def\gtu@etiketvar{1}\fi
    \if#2f\def\gtu@etiketvar{1}\fi
  \fi
  \ifnum\gtu@etiketvar=1
    \node[anchor=west,inner xsep=1.2mm,inner ysep=0.6mm,text=#1,font=\gtubaslikfont\large]
      (gtuE) at ([xshift=3mm]frame.north west) {\gtu@kutuetiketi};
  \fi
  \gtu@cerceve@gec{gtu kalem}{#1}{#2}{0pt}%
  \gtu@cerceve@gec{gtu ikinci}{#1}{#2}{0pt}%
  \ifnum#3=1 \gtu@cerceve@gec{gtu kalem,line width=0.45pt}{#1}{#2}{1.8pt}\fi}
\def\gtu@cerceve@gec#1#2#3#4{%
  \coordinate (gtuGB) at ([shift={(#4,#4)}]frame.south west);
  \coordinate (gtuKD) at ([shift={(-#4,-#4)}]frame.north east);
  \draw[#1,#2] (gtuGB|-gtuKD) to (gtuGB);
  \draw[#1,#2] (gtuKD) to (gtuKD|-gtuGB);
  \if#3u\gtu@ust{#1}{#2}\fi
  \if#3f\gtu@ust{#1}{#2}\fi
  \if#3u\draw[#1,#2] (gtuGB) to (gtuGB-|gtuKD);\fi
  \if#3l\draw[#1,#2] (gtuGB) to (gtuGB-|gtuKD);\fi}
\def\gtu@ust#1#2{%
  \ifnum\gtu@etiketvar=1
    \draw[#1,#2] (gtuGB|-gtuKD) to ([xshift=-0.4mm]gtuE.west|-gtuKD);
    \draw[#1,#2] ([xshift=0.4mm]gtuE.east|-gtuKD) to (gtuKD);
  \else
    \draw[#1,#2] (gtuGB|-gtuKD) to (gtuKD);
  \fi}

