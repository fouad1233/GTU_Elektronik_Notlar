%% =====================================================================
%%  gtu-el-yazisi.sty
%%  GTÜ Elektronik Mühendisliği -- el yazısı görünümlü ders notu şablonu
%%  (Handwritten-look template for digitised lecture notes)
%%
%%  Derleme / build : XeLaTeX  ->  latex-sablon/derle.sh dosya.tex
%%  Fontlar / fonts : Shantell Sans (gövde), Caveat (başlıklar) -- SIL OFL 1.1
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesPackage{gtu-el-yazisi}[2026/10/29 v1.0 GTU el yazisi ders notu sablonu]

%% ---------------------------------------------------------------------
%% 0. Motor kontrolü / engine check
%% ---------------------------------------------------------------------
\RequirePackage{iftex}
\iftutex\else
  \PackageError{gtu-el-yazisi}
    {Bu paket XeLaTeX ile derlenmelidir / XeLaTeX required}
    {Lutfen latex-sablon/derle.sh ile derleyin (pdfLaTeX desteklenmez).}
  \expandafter\endinput
\fi

%% ---------------------------------------------------------------------
%% 1. Seçenekler / options
%%    kagit    = kareli | cizgili | noktali | duz     (varsayılan: kareli)
%%    kalem    = ince | normal                        (gövde font kalınlığı)
%%    etiket   = tr | en                              (kutu etiketlerinin dili)
%%    numarali                                        (bölüm numaraları açık)
%%    fontpath = <klasör>/                            (fontlar başka yerdeyse)
%% ---------------------------------------------------------------------
\newif\ifgtu@en
\newif\ifgtu@numarali
\ExplSyntaxOn
\tl_new:N \g__gtu_kagit_tl
\tl_new:N \g__gtu_fontpath_tl
\tl_new:N \g__gtu_kalem_tl
\keys_define:nn { gtu }
  {
    kagit    .choices:nn  = { kareli , cizgili , noktali , duz }
                            { \tl_gset:Nn \g__gtu_kagit_tl {#1} } ,
    kagit    .initial:n   = kareli ,
    kalem    .choices:nn  = { ince , normal }
                            { \tl_gset:Nn \g__gtu_kalem_tl {#1} } ,
    kalem    .initial:n   = ince ,
    etiket   .choices:nn  = { tr , en }
                            { \str_if_eq:nnTF {#1} { en } { \gtu@entrue } { \gtu@enfalse } } ,
    etiket   .initial:n   = tr ,
    numarali .code:n      = \gtu@numaralitrue ,
    numarali .value_forbidden:n = true ,
    fontpath .tl_gset:N   = \g__gtu_fontpath_tl ,
  }
\ProcessKeyOptions [ gtu ]
\ExplSyntaxOff

%% ---------------------------------------------------------------------
%% 2. Matematik paketleri (euler, fontspec'ten ÖNCE yüklenmeli)
%%    Euler: Hermann Zapf'ın el yazısından esinlenen matematik fontu.
%%    Yunan harfleri, \sum \prod \int \oint \infty \partial buradan gelir.
%% ---------------------------------------------------------------------
\PassOptionsToPackage{table}{xcolor}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{euler}
\RequirePackage[no-math]{fontspec}

%% ---------------------------------------------------------------------
%% 3. Fontlar / fonts
%% ---------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \l__gtu_up_tl
\tl_new:N \l__gtu_it_tl
\tl_new:N \l__gtu_bf_tl
\tl_new:N \l__gtu_bfit_tl
\tl_new:N \l__gtu_pathopt_tl
\bool_new:N \l__gtu_found_bool
\str_if_eq:VnTF \g__gtu_kalem_tl { normal }
  {
    \tl_set:Nn \l__gtu_up_tl   { ShantellSans-Regular.ttf }
    \tl_set:Nn \l__gtu_it_tl   { ShantellSans-Italic.ttf }
    \tl_set:Nn \l__gtu_bf_tl   { ShantellSans-Bold.ttf }
    \tl_set:Nn \l__gtu_bfit_tl { ShantellSans-BoldItalic.ttf }
  }
  {
    \tl_set:Nn \l__gtu_up_tl   { ShantellSans-Light.ttf }
    \tl_set:Nn \l__gtu_it_tl   { ShantellSans-LightItalic.ttf }
    \tl_set:Nn \l__gtu_bf_tl   { ShantellSans-SemiBold.ttf }
    \tl_set:Nn \l__gtu_bfit_tl { ShantellSans-SemiBoldItalic.ttf }
  }
\msg_new:nnnn { gtu } { font-yok }
  {
    El~yazisi~fontlari~bulunamadi~(\l__gtu_up_tl).~
    Fonts~not~found.~Belgeyi~latex-sablon/derle.sh~ile~derleyin~veya~
    \token_to_str:N \usepackage[fontpath=<yol>/latex-sablon/fonts/]{gtu-el-yazisi}~
    kullanin.
  }
  { derle.sh~TTFONTS~degiskenini~ayarlar;~elle~derlerken~fontpath~verin. }
% Font arama sırası: fontpath seçeneği -> kpathsea (derle.sh TTFONTS) ->
% göreli klasörler (./fonts, ../latex-sablon/fonts, ...).
\tl_if_empty:NTF \g__gtu_fontpath_tl
  {
    \IfFontExistsTF { \l__gtu_up_tl }
      { \bool_set_true:N \l__gtu_found_bool }
      {
        \clist_map_inline:nn
          {
            ./fonts/ , ./latex-sablon/fonts/ , ../latex-sablon/fonts/ ,
            ../../latex-sablon/fonts/ , ../../../latex-sablon/fonts/ ,
            ../../../../latex-sablon/fonts/ , ../../../../../latex-sablon/fonts/
          }
          {
            \file_if_exist:nT { ##1 \l__gtu_up_tl }
              {
                \tl_set:Nn \l__gtu_pathopt_tl { Path = ##1 , }
                \bool_set_true:N \l__gtu_found_bool
                \clist_map_break:
              }
          }
      }
  }
  {
    \tl_set:Nx \l__gtu_pathopt_tl { Path = \g__gtu_fontpath_tl , }
    \bool_set_true:N \l__gtu_found_bool
  }
\bool_if:NF \l__gtu_found_bool { \msg_error:nn { gtu } { font-yok } }

% Gövde: Shantell Sans (Arrow Type) -- "irregular" alternatif harfler (rlig)
% sayesinde aynı harf her seferinde biraz farklı görünür. fi/fl bitişik
% harfleri Türkçe (i/ı) için kapalı.
\use:x
  {
    \exp_not:N \setmainfont { \l__gtu_up_tl }
      [
        \l__gtu_pathopt_tl
        ItalicFont     = \l__gtu_it_tl ,
        BoldFont       = \l__gtu_bf_tl ,
        BoldItalicFont = \l__gtu_bfit_tl ,
        Ligatures      = { TeX , NoCommon } ,
        Language       = Turkish ,
        Scale          = 0.95
      ]
    \exp_not:N \setsansfont { \l__gtu_up_tl }
      [
        \l__gtu_pathopt_tl
        ItalicFont     = \l__gtu_it_tl ,
        BoldFont       = \l__gtu_bf_tl ,
        BoldItalicFont = \l__gtu_bfit_tl ,
        Ligatures      = { TeX , NoCommon } ,
        Language       = Turkish ,
        Scale          = 0.95
      ]
    \exp_not:N \newfontfamily \exp_not:N \gtubaslikfont { Caveat-Bold.ttf }
      [ \l__gtu_pathopt_tl Ligatures = { TeX , NoCommon } , Scale = 1.2 ]
    \exp_not:N \newfontfamily \exp_not:N \gtuincefont { Caveat-Medium.ttf }
      [ \l__gtu_pathopt_tl Ligatures = { TeX , NoCommon } , Scale = 1.2 ]
  }
% kağıt türü çizim makrosu
\cs_gset:Npx \gtu@kagitciz { \exp_not:c { gtu@kagit@ \g__gtu_kagit_tl } }
\ExplSyntaxOff
% euler+fontspec, 'operators' matematik fontunu OT1/<gövde fontu> yapar; bu
% şekiller yoktur. Uyarı vermeden Computer Modern'e yönlendir.
\begingroup\edef\x{\endgroup
  \noexpand\DeclareFontFamily{OT1}{\rmdefault}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{m}{up}{<->ssub*cmr/m/n}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{m}{n}{<->ssub*cmr/m/n}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{m}{it}{<->ssub*cmr/m/it}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{b}{up}{<->ssub*cmr/bx/n}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{b}{n}{<->ssub*cmr/bx/n}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{bx}{up}{<->ssub*cmr/bx/n}{}%
  \noexpand\DeclareFontShape{OT1}{\rmdefault}{bx}{n}{<->ssub*cmr/bx/n}{}}\x

