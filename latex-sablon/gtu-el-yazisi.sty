  \par\noindent
  \begin{tikzpicture}
    \node[anchor=north west,inner xsep=5mm,inner ysep=3.5mm,text width=\linewidth-10mm,
      align=left,fill=kagitrengi](gtuNB){%
      \makebox[\linewidth][r]{\gtuincefont\small\color{kursunkalem}GTÜ · Elektronik Mühendisliği}\par
      \vspace{-1.2mm}%
      {\gtubaslikfont\fontsize{24pt}{29pt}\selectfont\color{kirmizikalem}#2\par}%
